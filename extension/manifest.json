{
  "manifest_version": 3,
  "name": "EYE Social Manager",
  "version": "0.1.0",
  "description": "Unified inbox for Facebook, X and Instagram — read comments/DMs, AI-draft a reply, fill it into the page while you're logged in. You always click Send yourself.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "EYE Social Manager"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "activeTab", "tabs", "alarms", "notifications"],
  "host_permissions": [
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://eye-analysis.online/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/x.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content/facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["content/instagram.js"],
      "run_at": "document_idle"
    }
  ]
}
